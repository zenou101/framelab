{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameLab",
  "version": "0.2.0",
  "identifier": "app.framelab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FrameLab",
        "width": 1320,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 700,
        "decorations": false,
        "visible": false,
        "center": true,
        "resizable": true,
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "FrameLab",
    "copyright": "FrameLab",
    "category": "Utility",
    "shortDescription": "Local-first gaming performance monitor and benchmarker",
    "longDescription": "FrameLab measures real CPU, GPU, memory and frame timings on Windows, records benchmark sessions locally, and explains what the measurements show.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "resources": [
      "binaries/presentmon/*"
    ]
  },
  "plugins": {}
}
